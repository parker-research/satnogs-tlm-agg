# SatNOGS Keys
SATNOGS_NETWORK_API_KEY=xxxxxx
SATNOGS_DB_API_KEY=xxxxxxx

# Optional: Hugging Face token, for higher rate limits when loading historical TLEs
HF_TOKEN=

# Optional: DuckDB memory cap (e.g. 4GB; default 80% of RAM) and thread count (default 4)
SATNOGS_TLM_AGG_MEMORY_LIMIT=
SATNOGS_TLM_AGG_THREADS=
